# TEMPLATE ONLY — never put real credentials in this file. Copy to ".env" and fill that in.

# --- shared SQL login (all four hospital clients + MSD are on one server) ---
SQL_SERVER=
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_USER=
SQL_PASS=

# --- one database per hospital client ---
# The key after DB_ must match the folder name under clients/, uppercased.
DB_MELBOURNE_HEALTH=
DB_NORTHERN_HEALTH=
DB_WESTERN_HEALTH=
DB_SYDNEY_ADVENTIST=

# Only needed if a client sits on a DIFFERENT server to SQL_SERVER above.
# SERVER_SYDNEY_ADVENTIST=

# --- QA databases (the only ones this pipeline writes to) ---
QA_DATABASE_PILOT=
QA_DATABASE=

# --- MSD (Master Supplier Database) ---
MSD_DATABASE=PI_Master_Supplier_Database_v2
MSD_SCHEMA=dbo
MSD_COHERENCE_CUT=0.5

# --- Layer B judge ---
# Backend is pluggable; the choice is deferred until Phase 0 reports judge-unit counts.
ANTHROPIC_API_KEY=
JUDGE_BACKEND=deferred
JUDGE_MODEL=claude-sonnet-5
JUDGE_CONFIDENCE_THRESHOLD=0.80
JUDGE_BATCH_SIZE=25
JUDGE_MAX_CONCURRENCY=4

# --- THE LIVE JURY (nim_judge.py) — THIS IS WHAT ACTUALLY JUDGES ---
# ⚠️ ADDED TO THIS TEMPLATE 2026-08-26, AND IT HAD BEEN MISSING SINCE THE JURY WAS BUILT.
# The four keys below are in the real .env and were absent here, so anyone setting up a new
# machine from this template — which is exactly what the office desktop is — would have got a
# complete-looking file that CANNOT JUDGE. The block above is the SUPERSEDED single-model
# backend; nothing runs on it. Found while adding the monitor keys, not by anyone checking.
NIM_API_KEY=
NIM_BASE_URL=
NIM_MODEL=
# The three-model jury, comma separated. Fewer than three is not a jury.
NIM_MODELS=

# --- run monitor: stall alert by email (pipeline/monitor.py) — OPTIONAL ---
# Leave these blank and NOTHING BREAKS: the monitor still runs and the page still turns red when
# the judge stops. Only the email is silent, and the page says so.
#
# ALERT_TO is where the warning lands — the easy one.
# ALERT_FROM / SMTP_USER / SMTP_PASS are the mailbox that SENDS it. They are not the same thing:
# an address you want to be told at is not an account that can send mail.
#
# ⚠️ Microsoft 365 turned OFF basic SMTP auth by default in 2022. If the sending mailbox is on
# M365, SMTP_PASS must be an APP PASSWORD (not the normal one), or IT must enable SMTP AUTH on
# that one mailbox. Enter an app password WITHOUT the spaces Microsoft displays it with.
MONITOR_SMTP_HOST=
MONITOR_SMTP_PORT=587
MONITOR_SMTP_USER=
MONITOR_SMTP_PASS=
MONITOR_ALERT_FROM=
MONITOR_ALERT_TO=
