# TEMPLATE ONLY — never put real credentials in this file. Copy to ".env" and fill that in.

# --- shared SQL login (all four hospital clients + MSD are on one server) ---
SQL_SERVER=
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_USER=
SQL_PASS=

# --- one database per hospital client ---
# The key after DB_ must match the folder name under clients/, uppercased.
DB_MELBOURNE_HEALTH=
DB_NORTHERN_HEALTH=
DB_WESTERN_HEALTH=
DB_SYDNEY_ADVENTIST=

# Only needed if a client sits on a DIFFERENT server to SQL_SERVER above.
# SERVER_SYDNEY_ADVENTIST=

# --- QA databases (the only ones this pipeline writes to) ---
QA_DATABASE_PILOT=
QA_DATABASE=

# --- MSD (Master Supplier Database) ---
MSD_DATABASE=PI_Master_Supplier_Database_v2
MSD_SCHEMA=dbo
MSD_COHERENCE_CUT=0.5

# --- Layer B judge ---
# Backend is pluggable; the choice is deferred until Phase 0 reports judge-unit counts.
ANTHROPIC_API_KEY=
JUDGE_BACKEND=deferred
JUDGE_MODEL=claude-sonnet-5
JUDGE_CONFIDENCE_THRESHOLD=0.80
JUDGE_BATCH_SIZE=25
JUDGE_MAX_CONCURRENCY=4
