# Copy to ".env" in the new project and fill in.  Do NOT commit/share the real .env.
# --- client fact-data SQL (the categorised invoice lines) ---
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASS=
SQL_DRIVER=ODBC Driver 17 for SQL Server

# --- MSD (master supplier database) - only if this client is already enriched in the MSD ---
# Leave blank to run fully on the fallback (no vendor coherence / no Layer A).
MSD_DATABASE=PI_Master_Supplier_Database_v2
MSD_SCHEMA=dbo
MSD_CLIENT_CODE=
MSD_COHERENCE_CUT=0.5
